import numpy as np 
import matplotlib.pyplot as plt

def gerador_Rede(L):
    rede = np.zeros((L,L))
    for i in range(L):
        for j in range(L):
            rede[i,j] = 1
    return rede

def Calculo_E(i,j,Rede,J,L):
    i_futuro = 0
    i_passado = 0
    j_futuro = 0
    j_passado = 0 

    if i == 0:
        i_futuro = i+1
        i_passado = L-1
    elif i == L-1:
        i_futuro = 0
        i_passado = i-1
    elif j == 0:
        j_passado = L-1
        j_futuro = j+1
    elif j == L-1:
        j_futuro = 0
        j_passado = j-1

    E_flip = 2*J*Rede[i,j]*(Rede[i_futuro,j]+Rede[i_passado,j]+Rede[i,j_futuro]+Rede[i,j_passado])

    return E_flip

def M_a(Rede,j):
    m=0
    for i in range(L):
        m += Rede[i,j]
    return m
def magnetização(m_a,r):
    return m_a*r

#constantes 
temperatura = [1.5,2,2.25,4,10] #k
L = 10 # numeros de linhas e colunas
J = 1 # energia do sistema
Rede = gerador_Rede(L)
max_inter = 1000
E_flip = 0 


for T in temperatura:
    soma =0
    M = []
    for intercao in range(max_inter):
        for i in range(L):
            for j in range(L):
                if i ==0 or i==L-1 or j==0 or j==L-1:
                    E_flip = Calculo_E(i,j,Rede,J,L)
                    r = np.random.rand()
                else:
                    E_flip = 2*J*Rede[i,j]*(Rede[i+1,j]+Rede[i-1,j]+Rede[i,j+1]+Rede[i,j-1])
                    r = np.random.rand()
                if E_flip < 0:
                    Rede[i,j]*=-1
                elif E_flip>0 and np.e**(-E_flip/T)>r:
                    Rede[i,j]*=-1
                
                M_alfa = M_a(Rede,j)
                soma += magnetização(M_alfa,-E_flip/(2*Rede[i,j]))/10000000

        M.append(soma)
    plt.plot(np.array(M),label="T = %0.2f"%T)
    plt.legend()
plt.show()
            
        
